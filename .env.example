# ===========================================
# LOCAL DEVELOPMENT
# ===========================================

# Twitch OAuth (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback

# Database (local docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/raid_autopilot

# Security (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_hex_key_here_64_chars
SESSION_SECRET=your_session_secret_here

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# API URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===========================================
# PRODUCTION (Railway + Vercel)
# ===========================================
#
# RAILWAY (API):
#   DATABASE_URL        -> Auto-provided by Railway Postgres addon
#   TWITCH_CLIENT_ID    -> Your Twitch app client ID
#   TWITCH_CLIENT_SECRET-> Your Twitch app secret
#   TWITCH_REDIRECT_URI -> https://your-api.railway.app/auth/twitch/callback
#   ENCRYPTION_KEY      -> openssl rand -hex 32
#   SESSION_SECRET      -> openssl rand -hex 32
#   CORS_ORIGIN         -> https://your-app.vercel.app
#
# VERCEL (Web):
#   NEXT_PUBLIC_API_URL -> https://your-api.railway.app
#
# Remember to update your Twitch app's OAuth redirect URI!
